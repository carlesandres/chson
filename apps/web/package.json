{
  "name": "@chson/web",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "portless",
    "dev:app": "next dev",
    "build": "next build",
    "start": "next start",
    "favicon": "node scripts/generate-favicon.mjs",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "prettify": "npx prettier --write --log-level silent .",
    "lint": "npm run typecheck && oxlint --tsconfig tsconfig.json --fix",
    "lint:check": "oxlint --tsconfig tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "portless": {
    "name": "chson",
    "script": "dev:app"
  },
  "dependencies": {
    "@chson/registry": "*",
    "@chson/schema": "*",
    "@chson/ui": "*",
    "@streamdown/code": "1.1.1",
    "@tanstack/react-query": "5.105.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-ui": "16.17.10",
    "immer": "11.2.9",
    "lodash": "^4.18.1",
    "lucide-react": "1.67.0",
    "marked": "^13.0.3",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "streamdown": "2.7.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@tanstack/react-query-devtools": "5.105.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.19.33",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "4.1.3",
    "@vitest/ui": "4.1.3",
    "eslint-plugin-tailwindcss": "4.4.0",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "oxlint": "1.91.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.2.2",
    "typescript": "6.0.2",
    "vitest": "4.1.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
