{
  "name": "@chson/web",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "portless",
    "dev:app": "next dev",
    "build": "next build",
    "start": "next start",
    "favicon": "node scripts/generate-favicon.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "prettify": "npx prettier --write --log-level silent .",
    "lint": "tsc -p tsconfig.typecheck.json --noEmit && oxlint --tsconfig tsconfig.json --fix",
    "lint:check": "oxlint --tsconfig tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "gen-types": "supabase gen types typescript --linked --schema public > ./types/supabase.ts"
  },
  "portless": {
    "name": "chson",
    "script": "dev:app"
  },
  "dependencies": {
    "@chson/registry": "*",
    "@chson/schema": "*",
    "@chson/ui": "*",
    "@streamdown/code": "1.1.1",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.102.1",
    "@tanstack/react-query": "5.96.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "fumadocs-core": "16.7.10",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-ui": "16.7.10",
    "immer": "11.1.4",
    "lodash": "^4.18.1",
    "lucide-react": "1.7.0",
    "marked": "^13.0.3",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "streamdown": "2.5.0",
    "supabase": "^1.226.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query-devtools": "5.96.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.19.33",
    "@types/react": "19.2.14",
    "@vitest/coverage-v8": "4.1.3",
    "@vitest/ui": "4.1.3",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "oxlint": "1.59.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "6.0.2",
    "vitest": "4.1.3"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
