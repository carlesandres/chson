{
  "name": "@chson/ui",
  "version": "0.0.1",
  "description": "React components for rendering ChSON documents",
  "license": "MIT",
  "author": "Carles Andres",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./types/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carlesandres/chson.git",
    "directory": "packages/chson-ui"
  },
  "homepage": "https://chson.dev",
  "bugs": {
    "url": "https://github.com/carlesandres/chson/issues"
  },
  "keywords": [
    "chson",
    "react",
    "ui",
    "cheatsheet",
    "checklist",
    "runbook",
    "tldr",
    "bookmarks"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@chson/schema": "*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-progress": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "27.4.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.0"
  }
}
