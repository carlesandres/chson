{
  "name": "@chson/schema",
  "version": "2.0.0",
  "description": "ChSON JSON Schema and TypeScript type definitions",
  "license": "MIT",
  "author": "Carles Andres",
  "type": "module",
  "main": "./schema/chson.schema.json",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./schema/chson.schema.json"
    },
    "./chson.schema.json": "./schema/chson.schema.json",
    "./types": "./types/index.d.ts"
  },
  "files": [
    "schema",
    "types",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carlesandres/chson.git",
    "directory": "packages/chson-schema"
  },
  "homepage": "https://chson.dev",
  "bugs": {
    "url": "https://github.com/carlesandres/chson/issues"
  },
  "keywords": [
    "chson",
    "cheatsheet",
    "json-schema",
    "schema",
    "typescript",
    "types",
    "json"
  ],
  "scripts": {
    "build": "node scripts/build-types.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.6.2",
    "vitest": "^4.0.18"
  }
}
