{
  "name": "@chson/schema",
  "version": "2.0.0",
  "private": true,
  "description": "ChSON JSON Schema and TypeScript type definitions",
  "type": "module",
  "main": "./schema/chson.schema.json",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./schema/chson.schema.json"
    },
    "./chson.schema.json": "./schema/chson.schema.json",
    "./types": "./types/index.d.ts"
  },
  "files": [
    "schema",
    "types"
  ],
  "scripts": {
    "build": "node scripts/build-types.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.6.2",
    "vitest": "^4.0.18"
  }
}
