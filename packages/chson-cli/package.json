{
  "name": "@chson/cli",
  "version": "1.0.0",
  "description": "CLI for validating, rendering, and distributing ChSON cheatsheet files",
  "license": "MIT",
  "author": "Carles Andres",
  "type": "module",
  "bin": {
    "chson": "./src/chson.js"
  },
  "files": [
    "src/chson.js",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carlesandres/chson.git",
    "directory": "packages/chson-cli"
  },
  "homepage": "https://chson.dev",
  "bugs": {
    "url": "https://github.com/carlesandres/chson/issues"
  },
  "keywords": [
    "chson",
