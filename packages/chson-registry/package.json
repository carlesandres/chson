{
  "name": "@chson/registry",
  "version": "1.0.0",
  "description": "Curated collection of ChSON cheatsheets — structured data files for developer reference.",
  "license": "MIT",
  "author": "Carles Andres",
  "type": "module",
  "main": "./index.json",
  "exports": {
    ".": "./index.json",
    "./cheatsheets/*": "./cheatsheets/*"
  },
  "files": [
    "index.json",
    "cheatsheets",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carlesandres/chson.git",
    "directory": "packages/chson-registry"
  },
  "homepage": "https://chson.dev",
  "bugs": {
    "url": "https://github.com/carlesandres/chson/issues"
  },
  "keywords": [
    "chson",
    "cheatsheet",
    "cheatsheets",
    "registry",
    "reference",
    "json",
    "data"
  ],
  "scripts": {
    "build": "node scripts/build-index.js",
    "validate": "node ../chson-cli/src/chson.js validate cheatsheets",
    "render": "node ../chson-cli/src/chson.js render markdown cheatsheets",
    "render:build": "node ../chson-cli/src/chson.js render markdown cheatsheets --out ../../build/registry-md"
  }
}
